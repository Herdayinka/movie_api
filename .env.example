# Copy this file to .env and replace the value with your MongoDB connection string
# For a local MongoDB server:
# MONGO_URI=mongodb://127.0.0.1:27017/moviedb

# For MongoDB Atlas use the connection string provided by Atlas (keep credentials secret):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/myDatabase?retryWrites=true&w=majority

# Optional: change the app port
# PORT=3000
